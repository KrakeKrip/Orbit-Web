# Локальная конфигурация разработки Orbit.
# Скопируйте файл в .env и заполните реальными значениями: .env игнорируется Git.
# Реальные секреты храните только в .env; в репозиторий они не попадают.

# Порт локального PostgreSQL. Compose публикует порт только на 127.0.0.1.
ORBIT_DB_PORT=55432

# Учётная запись и имя dev-базы, которые создаёт контейнер при первом старте.
ORBIT_DB_USER=orbit
ORBIT_DB_NAME=orbit_dev

# Локальный пароль PostgreSQL. Сгенерируйте свой, например:
#   openssl rand -hex 24
ORBIT_DB_PASSWORD=change-me-local-only

# Строка подключения для Drizzle/приложения (локальная dev-база).
DATABASE_URL=postgresql://orbit:change-me-local-only@127.0.0.1:55432/orbit_dev

# Явное разрешение test-режима для npm run test:db (fallback на DATABASE_URL
# отсутствует). URL задаёт локальный сервер (host 127.0.0.1/localhost/::1,
# явные port/user/password, без query-параметров) и namespace orbit_test.
# Раннер создаёт уникальную базу orbit_test_<запуск> и удаляет только её;
# ранее существовавшие базы не затрагиваются.
TEST_DATABASE_URL=postgresql://orbit:change-me-local-only@127.0.0.1:55432/orbit_test

# Runtime auth (обязателен для входа в приложение: npm run dev / npm start).
# Без этих переменных auth-запросы и защищённые страницы fail-closed.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Секрет сессий: минимум 32 символа случайности, сгенерируйте свой:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-generate-openssl-rand-hex-32
